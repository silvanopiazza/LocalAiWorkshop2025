





# Cell 3: CPU-friendly text generation demo
try:
    from transformers import pipeline
    gen = pipeline('text-generation', model='distilgpt2')
    out = gen('Bioinformatics enables', max_length=50, num_return_sequences=1)
    print(out[0]['generated_text'])
except Exception as e:
    print('Failed to run transformers pipeline — make sure transformers is installed and you have internet to download the model.')
    print('Error:', e)









